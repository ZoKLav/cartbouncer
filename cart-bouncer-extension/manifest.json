{
  "manifest_version": 3,
  "name": "Cart Bouncer — Amazon Filter",
  "version": "1.2.0",
  "description": "Give unwanted Amazon listings the boot. Block brands, sellers, keywords and low-rated products.",
  "icons": {"16":"icons/icon-16.png", "32":"icons/icon-32.png", "48":"icons/icon-48.png", "128":"icons/icon-128.png"},
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.com.au/*", "*://*.amazon.co.jp/*", "*://*.amazon.in/*"],
  "background": {"service_worker":"background.js"},
  "action": {"default_popup":"popup.html", "default_title":"Cart Bouncer — no nonsense, please", "default_icon":{"16":"icons/icon-16.png","32":"icons/icon-32.png"}},
  "options_page":"options.html",
  "content_scripts":[{
    "matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.ca/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.com.au/*", "*://*.amazon.co.jp/*", "*://*.amazon.in/*"],
    "css":["content.css"], "js":["watchlist.js", "content.js"], "run_at":"document_start"
  }]
}
